    {
      "id": "al04-p007",
      "chapter": 4,
      "difficulty": 3,
      "title": "Solve a base-2 exponential",
      "tags": ["exponential", "solve"],
      "kind": "numeric",
      "scenario": "Solve for $x$:\n\n$$2^x = 16$$",
      "answer": 4,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["2 to what power is 16?", "Or $x = \\log 16/\\log 2$."],
      "solution": "Take logs and use the power law:\n\n$$2^x = 16 \\;\\Rightarrow\\; x\\log 2 = \\log 16 \\;\\Rightarrow\\; x = \\frac{\\log 16}{\\log 2} = 4$$\n\n(Check: $2^4 = 16$.)",
      "equationsUsed": ["x = \\log 16/\\log 2 = 4"],
      "conceptLink": "al04"
    },
    {
      "id": "al04-p008",
      "chapter": 4,
      "difficulty": 3,
      "title": "Combine logs then evaluate",
      "tags": ["logs", "product law"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$\\log_{10}(2) + \\log_{10}(50)$$",
      "answer": 2,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Product law: $\\log a + \\log b = \\log(ab)$.", "$2\\times 50 = 100$."],
      "solution": "Combine with the product law:\n\n$$\\log 2 + \\log 50 = \\log(2\\times 50) = \\log 100 = 2$$",
      "equationsUsed": ["\\log 2 + \\log 50 = 2"],
      "conceptLink": "al04"
    },
    {
