      "difficulty": 1,
      "title": "Multiply powers",
      "tags": ["indices", "multiply"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$2^3 \\times 2^2$$",
      "answer": 32,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Same base — add the indices.", "$2^{3+2} = 2^5$."],
      "solution": "Add the indices (same base):\n\n$$2^3\\times2^2 = 2^{3+2} = 2^5 = 32$$",
      "equationsUsed": ["2^3\\times2^2 = 2^5"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p002",
      "chapter": 3,
      "difficulty": 1,
      "title": "Divide powers of ten",
      "tags": ["indices", "divide"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$\\frac{10^6}{10^2}$$",
      "answer": 10000,
      "unit": "",
      "tolerance": 1,
      "hints": ["Same base — subtract the indices.", "$10^{6-2} = 10^4$."],
      "solution": "Subtract the indices:\n\n$$\\frac{10^6}{10^2} = 10^{6-2} = 10^4 = 10000$$",
      "equationsUsed": ["10^6/10^2 = 10^4"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p003",
      "chapter": 3,
      "difficulty": 1,
      "title": "Zero index",
      "tags": ["indices", "zero", "mcq"],
      "kind": "mcq",
      "scenario": "What is the value of $a^0$ (for any non-zero $a$)?",
      "choices": ["$1$", "$0$", "$a$", "Undefined"],
      "answerIndex": 0,
      "hints": ["Think $a^n \\div a^n$.", "Anything divided by itself is 1."],
      "solution": "Since $a^n \\div a^n = a^{n-n} = a^0$ and also equals 1, we have $a^0 = 1$ for any non-zero $a$.",
      "equationsUsed": ["a^0 = 1"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p004",
      "chapter": 3,
      "difficulty": 2,
      "title": "Power of a power",
      "tags": ["indices", "power of power"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$(3^2)^2$$",
      "answer": 81,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Multiply the indices.", "$3^{2\\times2} = 3^4$."],
      "solution": "Multiply the indices:\n\n$$(3^2)^2 = 3^{2\\times2} = 3^4 = 81$$",
      "equationsUsed": ["(3^2)^2 = 3^4"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p005",
      "chapter": 3,
      "difficulty": 2,
      "title": "Negative index",
      "tags": ["indices", "negative"],
      "kind": "numeric",
      "scenario": "Evaluate as a decimal:\n\n$$2^{-3}$$",
      "answer": 0.125,
      "unit": "",
      "tolerance": 0.001,
      "hints": ["A negative index means one over the positive power.", "$2^{-3} = 1/2^3 = 1/8$."],
      "solution": "Negative index = reciprocal:\n\n$$2^{-3} = \\frac{1}{2^3} = \\frac{1}{8} = 0.125$$",
      "equationsUsed": ["2^{-3} = 1/8"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p006",
      "chapter": 3,
      "difficulty": 2,
      "title": "Square root as a power",
      "tags": ["roots", "fractional index"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$16^{1/2}$$",
      "answer": 4,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["The power $\\tfrac12$ means the square root.", "$\\sqrt{16} = 4$."],
      "solution": "A power of $\\tfrac12$ is a square root:\n\n$$16^{1/2} = \\sqrt{16} = 4$$",
      "equationsUsed": ["16^{1/2} = 4"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p007",
      "chapter": 3,
      "difficulty": 3,
      "title": "Fractional index",
      "tags": ["roots", "fractional index"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$8^{2/3}$$",
      "answer": 4,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Bottom is the root, top is the power: $(\\sqrt[3]{8})^2$.", "$\\sqrt[3]{8} = 2$, then square."],
      "solution": "Root by the denominator, power by the numerator:\n\n$$8^{2/3} = \\left(\\sqrt[3]{8}\\right)^2 = 2^2 = 4$$",
      "equationsUsed": ["8^{2/3} = 4"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p008",
      "chapter": 3,
      "difficulty": 3,
      "title": "Mixed root and power",
      "tags": ["roots", "powers"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$27^{1/3} + 4^2$$",
      "answer": 19,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["$27^{1/3} = \\sqrt[3]{27} = 3$.", "$4^2 = 16$; add them."],
      "solution": "Evaluate each term, then add:\n\n$$27^{1/3} = \\sqrt[3]{27} = 3, \\qquad 4^2 = 16$$\n$$3 + 16 = 19$$",
      "equationsUsed": ["27^{1/3} = 3", "4^2 = 16"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p009",
      "chapter": 3,
      "difficulty": 3,
      "title": "Simplify an index expression",
      "tags": ["indices", "simplify", "symbolic"],
      "kind": "open",
      "scenario": "Simplify to a single power of $x$:\n\n$$\\frac{x^5 \\cdot x^3}{x^2}$$",
      "hints": ["Multiply the top: add indices → $x^8$.", "Divide by $x^2$: subtract → $x^{8-2}$."],
      "solution": "Add for the multiplication, subtract for the division:\n\n$$\\frac{x^5\\cdot x^3}{x^2} = \\frac{x^{8}}{x^2} = x^{8-2} = x^6$$",
      "equationsUsed": ["x^6"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p010",
      "chapter": 3,
      "difficulty": 3,
      "title": "Scientific notation divide",
      "tags": ["scientific notation"],
      "kind": "numeric",
      "scenario": "Evaluate (give the ordinary number):\n\n$$\\frac{6 \\times 10^8}{2 \\times 10^3}$$",
      "answer": 300000,
      "unit": "",
      "tolerance": 100,
      "hints": ["Divide the fronts: $6/2 = 3$.", "Subtract the powers: $10^{8-3} = 10^5$."],
      "solution": "Fronts and powers of ten separately:\n\n$$\\frac{6\\times10^8}{2\\times10^3} = \\frac{6}{2}\\times10^{8-3} = 3\\times10^5 = 300000$$",
      "equationsUsed": ["3\\times10^5 = 300000"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p011",
      "chapter": 3,
      "difficulty": 4,
      "title": "Fractional power, numerator > 1",
      "tags": ["roots", "fractional index"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$9^{3/2}$$",
      "answer": 27,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Root by the bottom: $\\sqrt{9} = 3$.", "Power by the top: $3^3$."],
      "solution": "Take the square root, then cube:\n\n$$9^{3/2} = \\left(\\sqrt{9}\\right)^3 = 3^3 = 27$$",
      "equationsUsed": ["9^{3/2} = 27"],
      "conceptLink": "al03"
    },
    {
      "id": "al03-p012",
      "chapter": 3,
      "difficulty": 4,
      "title": "Combine negative and positive indices",
      "tags": ["indices", "negative"],
      "kind": "numeric",
      "scenario": "Evaluate:\n\n$$5^{-2} \\times 5^{4}$$",
      "answer": 25,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Same base — add the indices, including the negative.", "$5^{-2+4} = 5^2$."],
      "solution": "Add the indices (a negative index just subtracts):\n\n$$5^{-2}\\times5^4 = 5^{-2+4} = 5^2 = 25$$",
