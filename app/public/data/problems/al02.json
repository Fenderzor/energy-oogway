      "kind": "numeric",
      "scenario": "Work out, as a decimal:\n\n$$\\frac{5}{6} - \\frac{1}{3}$$",
      "answer": 0.5,
      "unit": "",
      "tolerance": 0.001,
      "hints": ["Rewrite $\\tfrac13$ as $\\tfrac26$.", "$\\tfrac56 - \\tfrac26 = \\tfrac36$."],
      "solution": "Common denominator 6:\n\n$$\\frac{5}{6} - \\frac{1}{3} = \\frac{5}{6} - \\frac{2}{6} = \\frac{3}{6} = \\frac{1}{2} = 0.5$$",
      "equationsUsed": ["\\frac{5}{6} - \\frac{1}{3} = \\frac{1}{2}"],
      "conceptLink": "al02"
