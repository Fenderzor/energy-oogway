      "kind": "numeric",
      "scenario": "Find $x$:\n\n$$\\frac{x}{12} = \\frac{3}{4}$$",
      "answer": 9,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Cross-multiply: $4x = 3\\times 12$.", "$4x = 36$."],
      "solution": "Cross-multiply and solve:\n\n$$\\frac{x}{12} = \\frac{3}{4} \\;\\Rightarrow\\; 4x = 36 \\;\\Rightarrow\\; x = 9$$",
      "equationsUsed": ["4x = 36"],
      "conceptLink": "al02"
