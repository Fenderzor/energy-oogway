      "title": "Percentage of a quantity",
      "tags": ["percentage"],
      "kind": "numeric",
      "scenario": "What is $15\\%$ of $80$?",
      "answer": 12,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["'Percent' means ÷100: $15\\% = \\tfrac{15}{100}$.", "Multiply: $\\tfrac{15}{100}\\times 80$."],
      "solution": "Turn the percent into a fraction and multiply:\n\n$$15\\%\\text{ of }80 = \\frac{15}{100}\\times 80 = 0.15\\times 80 = 12$$",
      "equationsUsed": ["\\frac{15}{100}\\times 80 = 12"],
      "conceptLink": "al02"
    },
