      "difficulty": 4,
      "title": "Scale a proportional quantity",
      "tags": ["proportion", "energy"],
      "kind": "numeric",
      "scenario": "Burning **3 kg** of a fuel releases **40 MJ**. Assuming a constant energy density, how many **MJ** does burning **7.5 kg** release?",
      "answer": 100,
      "unit": "MJ",
      "tolerance": 0.5,
      "hints": ["Set up a proportion: $\\tfrac{40}{3} = \\tfrac{E}{7.5}$.", "Energy density $= 40/3 \\approx 13.33$ MJ/kg."],
      "solution": "Energy is proportional to mass, so cross-multiply:\n\n$$\\frac{40}{3} = \\frac{E}{7.5} \\;\\Rightarrow\\; E = \\frac{40}{3}\\times 7.5 = 13.33\\times 7.5 = 100\\ \\text{MJ}$$",
      "equationsUsed": ["E = \\frac{40}{3}\\times 7.5 = 100"],
      "conceptLink": "al02"
    }
