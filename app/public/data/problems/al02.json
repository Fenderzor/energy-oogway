      "title": "Simplify a fraction",
      "tags": ["fractions", "simplify", "mcq"],
      "kind": "mcq",
      "scenario": "Simplify $\\dfrac{12}{18}$ to its lowest terms.",
      "choices": ["$\\dfrac{2}{3}$", "$\\dfrac{3}{4}$", "$\\dfrac{6}{9}$", "$\\dfrac{4}{6}$"],
      "answerIndex": 0,
