    {
      "id": "al02-p007",
      "chapter": 2,
      "difficulty": 3,
      "title": "Share in a ratio",
      "tags": ["ratio", "sharing"],
      "kind": "numeric",
      "scenario": "Split **200** in the ratio $3:2$. What is the **larger** share?",
      "answer": 120,
      "unit": "",
      "tolerance": 0.5,
      "hints": ["Add the parts: $3 + 2 = 5$ shares.", "One share $= 200/5 = 40$; the larger is $3$ shares."],
      "solution": "Find one part, then scale:\n\n$$\\text{parts} = 3 + 2 = 5, \\quad \\text{one part} = \\frac{200}{5} = 40$$\n$$\\text{larger share} = 3 \\times 40 = 120$$\n\n(The other share is $2\\times40 = 80$; check: $120 + 80 = 200$ ✓.)",
      "equationsUsed": ["3\\times 40 = 120"],
      "conceptLink": "al02"
    },
    {
