      "title": "Proportion with unknown denominator",
      "tags": ["proportion", "cross-multiply"],
      "kind": "numeric",
      "scenario": "Find $x$:\n\n$$\\frac{7}{x} = \\frac{14}{6}$$",
      "answer": 3,
      "unit": "",
      "tolerance": 0.01,
      "hints": ["Cross-multiply: $7\\times 6 = 14\\,x$.", "$42 = 14x$."],
      "solution": "Cross-multiply and solve:\n\n$$\\frac{7}{x} = \\frac{14}{6} \\;\\Rightarrow\\; 7\\times 6 = 14x \\;\\Rightarrow\\; 42 = 14x \\;\\Rightarrow\\; x = 3$$",
      "equationsUsed": ["42 = 14x"],
      "conceptLink": "al02"
    },
